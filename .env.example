# Copiez ce fichier en `.env` et remplissez les valeurs. Ne le partagez jamais.

# Base de données. En local : fichier SQLite. En production : l'URL PostgreSQL de Supabase.
DATABASE_URL="file:./dev.db"

# Adresse publique de l'application (sert aux liens d'invitation).
APP_URL="http://localhost:3000"

# Emails ayant l'accès super admin (accès à toutes les entreprises clientes), séparés par des virgules.
SUPER_ADMIN_EMAILS="jocelin.querteux.lms@gmail.com"
