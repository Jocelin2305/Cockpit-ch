# Copiez ce fichier en `.env` et remplissez les valeurs. Ne le partagez jamais.

# Base de données. En local : fichier SQLite. En production : l'URL PostgreSQL de Supabase.
DATABASE_URL="file:./dev.db"

# Adresse publique de l'application (sert aux liens d'invitation).
APP_URL="http://localhost:3000"

# Clé API Anthropic (console.anthropic.com) : active l'assistant et les fonctions IA.
ANTHROPIC_API_KEY=""
# Modèle utilisé (facultatif). Par défaut : claude-opus-5-5.
# ANTHROPIC_MODEL="claude-opus-5-5"

# Stripe (dashboard.stripe.com). Commencez par les clés de TEST (sk_test_…), gratuites.
STRIPE_SECRET_KEY=""
# Secret du webhook (whsec_…), pour l'adresse /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=""
# Identifiants des prix mensuels créés dans Stripe (price_…), un par offre de src/lib/plans.ts.
STRIPE_PRICE_SOLO=""
STRIPE_PRICE_EQUIPE=""

# Emails ayant l'accès super admin (accès à toutes les entreprises clientes), séparés par des virgules.
SUPER_ADMIN_EMAILS="jocelin.querteux.lms@gmail.com"
