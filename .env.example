# Copiez ce fichier en `.env` et remplissez les valeurs. Ne le partagez jamais.

# Base PostgreSQL Supabase (Project Settings → Database → Connection string).
# DATABASE_URL : « Transaction pooler » (port 6543), suivi de ?pgbouncer=true&connection_limit=1
# DIRECT_URL : « Session pooler » ou connexion directe (port 5432), utilisée pour les migrations.
DATABASE_URL=""
DIRECT_URL=""

# Adresse publique de l'application (sert aux liens d'invitation).
APP_URL="http://localhost:3000"

# Clé API Anthropic (console.anthropic.com) : active l'assistant et les fonctions IA.
ANTHROPIC_API_KEY=""
# Modèle utilisé (facultatif). Par défaut : claude-opus-5-5.
# ANTHROPIC_MODEL="claude-opus-5-5"

# Stripe (dashboard.stripe.com). Commencez par les clés de TEST (sk_test_…), gratuites.
STRIPE_SECRET_KEY=""
# Secret du webhook (whsec_…), pour l'adresse /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=""
# Identifiants des prix mensuels créés dans Stripe (price_…), un par offre de src/lib/plans.ts.
STRIPE_PRICE_SOLO=""
STRIPE_PRICE_EQUIPE=""

# Emails ayant l'accès super admin (accès à toutes les entreprises clientes), séparés par des virgules.
SUPER_ADMIN_EMAILS="jocelin.querteux.lms@gmail.com"

# Messagerie (sprint 5). Identifiants OAuth de Cockpit'ch, à créer dans Google Cloud et Microsoft Entra.
# Adresse de retour à déclarer : APP_URL + /api/mail/google/callback et /api/mail/microsoft/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Clé de chiffrement des jetons de messagerie (32 octets en base64). Ne jamais la changer après coup.
TOKEN_ENCRYPTION_KEY=""
