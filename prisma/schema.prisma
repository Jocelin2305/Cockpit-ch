// Modèle de données du socle : comptes, entreprises clientes, rôles, invitations.
// Base PostgreSQL (Supabase), en local comme en production.
// DATABASE_URL : connexion via le pooler (application) ; DIRECT_URL : connexion directe (migrations).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  // Accès à l'ensemble des comptes clients. Toujours vrai pour le fondateur (SUPER_ADMIN_EMAILS),
  // qui est le seul à pouvoir l'accorder ou le retirer aux autres.
  isSuperAdmin Boolean      @default(false)
  // Signature des emails, remplace {signature} dans les séquences.
  signature    String       @default("")
  // Guide d'adoption (infobulles) activé, réglé dans le Centre d'aide.
  guideOn      Boolean      @default(true)
  // Acceptation des CGU et de la politique de confidentialité (inscription ou invitation).
  termsAcceptedAt DateTime?
  // Étape en cours de la visite guidée (null : pas de visite en cours).
  tourStep     Int?
  // Dernier jour (AAAA-MM-JJ) où le point du jour a été affiché.
  briefingDay  String?
  // Rapport hebdomadaire par email (administrateurs), envoi automatique des relances dues, checklist de démarrage masquée.
  weeklyReport Boolean      @default(true)
  autoSend     Boolean      @default(false)
  onboardingHidden Boolean  @default(false)
  createdAt    DateTime     @default(now())
  lastLoginAt  DateTime?
  memberships  Membership[]
  sessions     Session[]
  prospects    Prospect[]
  mailAccount  MailAccount?
}

// Une entreprise cliente : ses données sont isolées de celles des autres.
model Organization {
  id          String       @id @default(cuid())
  name        String
  // Offre choisie (identifiant de src/lib/plans.ts) ; « essai » tant qu'aucun abonnement n'est souscrit.
  plan        String       @default("essai")
  // Fin de l'essai gratuit, fixée à l'inscription.
  trialEndsAt DateTime?
  // Abonnement Stripe, tenu à jour par le webhook.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  // Téléphonie connectée (aircall, ringover, generique) et jeton secret de son webhook.
  phoneProvider        String?
  phoneWebhookToken    String?   @unique
  // Clé d'IA de l'entreprise (chiffrée) ; sans elle, la clé de la plateforme sert.
  aiProvider           String?
  aiKeyEnc             String?
  // CRM connecté (hubspot, pipedrive) et son jeton d'accès chiffré.
  crmProvider          String?
  crmTokenEnc          String?
  // Clé API Apollo du client (chiffrée), pour enrichir les contacts.
  apolloKeyEnc         String?
  // Revendeur qui a apporté ce client (commission), et espace propre d'un revendeur (accès offert).
  resellerId           String?
  reseller             Reseller? @relation(fields: [resellerId], references: [id], onDelete: SetNull)
  isPartner            Boolean   @default(false)
  // Client d'un distributeur : prix HT qu'il lui facture (base de la commission), et sa périodicité.
  resellerPrice        Float?
  resellerBilling      String?
  // Nombre d'utilisateurs accordé par le distributeur à son client.
  resellerSeats        Int?
  // Dernier rapport hebdomadaire envoyé (évite un double envoi).
  lastReportAt         DateTime?
  optOuts              OptOut[]
  createdAt   DateTime     @default(now())
  memberships Membership[]
  invitations Invitation[]
  searches    Search[]
  templates   SequenceTemplate[]
  prospects   Prospect[]
}

// Rôle d'un utilisateur dans une entreprise : ADMIN ou MEMBER (commercial).
model Membership {
  id             String       @id @default(cuid())
  role           String
  createdAt      DateTime     @default(now())
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// Seule l'empreinte du jeton est stockée : une fuite de la base ne permet pas d'ouvrir une session.
model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  organizationId String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Cockpit ----------
// Les dates de suivi (premier contact, relances, rappels) sont des jours « AAAA-MM-JJ » au fuseau de l'entreprise.

// Une recherche = une bibliothèque de prospects, ses critères et sa séquence.
model Search {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  geo            String            @default("")
  secteur        String            @default("")
  ca             String            @default("")
  salaries       String            @default("")
  motifs         String            @default("")
  activite       String            @default("")
  prix           String            @default("")
  diff           String            @default("")
  fonctions      String            @default("")
  volume         String            @default("")
  ton            String            @default("")
  notes          String            @default("")
  // Critères de la recherche automatique (registre des entreprises) : codes région, départements, section et codes NAF,
  // mot-clé, tranches d'effectif (codes INSEE), CA min et max en euros.
  srcRegion      String            @default("")
  srcDeps        String            @default("")
  srcSection     String            @default("")
  srcNaf         String            @default("")
  srcKeyword     String            @default("")
  srcEffectifs   String            @default("")
  srcCaMin       String            @default("")
  srcCaMax       String            @default("")
  // Dernière page du registre parcourue, pour que chaque lancement apporte de nouvelles entreprises.
  sourcedPage    Int               @default(0)
  sourcedAt      DateTime?
  templateId     String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       SequenceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  prospects      Prospect[]

  @@index([organizationId])
}

// Modèle de séquence : emails (J0 + 5 relances) et LinkedIn en parallèle.
model SequenceTemplate {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  delays         Json         // délais des relances email (0 à 8), en jours après l'email J0
  liDelays       Json?        // délais des relances LinkedIn (0 à 5), en jours après l'invitation
  steps          Json         // textes par étape (email, relance1Objet, linkedinInvitation…)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  searches       Search[]

  @@index([organizationId])
}

model Prospect {
  id             String       @id @default(cuid())
  organizationId String
  searchId       String?
  ownerId        String?
  company        String
  sector         String       @default("")
  city           String       @default("")
  size           String       @default("")
  contactName    String       @default("")
  contactRole    String       @default("")
  phone          String       @default("")
  email          String       @default("")
  emailVerified  Boolean      @default(false)
  linkedin       String       @default("")
  website        String       @default("")
  clientele      String       @default("")
  standing       String       @default("")
  offreExistante String       @default("")
  actualite      String       @default("")
  qualification  String       @default("")
  canal          String       @default("")
  problematiques String       @default("")
  signals        String       @default("")
  angle          String       @default("")
  // Argumentaire complet derrière l'angle (résumé) : repris dans les séquences via {argumentaire}.
  angleDetail    String       @default("")
  notes          String       @default("")
  priority       String       @default("B")
  status         String       @default("À contacter")
  relances       Int          @default(0)
  firstContact   String?
  lastContact    String?
  nextFollowUp   String?
  callBack       String?
  lastCallAt     String?
  qualif         Json?
  sequence       Json?
  // Jour du passage en RDV et du gain (rapport hebdomadaire) ; désinscription du prospect (plus aucun email).
  rdvDay         String?
  wonDay         String?
  optOutAt       DateTime?
  // Séquence stoppée à la main (clic droit) : plus aucun email ni relance jusqu'à la reprise.
  seqStoppedAt   DateTime?
  // Entreprise trouvée par la recherche automatique (SIREN) et contact enrichi par Apollo.
  siren          String?
  source         String       @default("")
  apolloId       String?
  enrichedAt     DateTime?
  // Fiche correspondante dans le CRM connecté.
  crmId          String?
  crmSyncedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  search         Search?      @relation(fields: [searchId], references: [id], onDelete: SetNull)
  owner          User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  calls          Call[]
  // Fil Gmail de la séquence et Message-ID du dernier email envoyé : les relances répondent dans le même fil.
  mailThreadId   String?
  mailMessageId  String?
  mails          MailMessage[]

  @@index([organizationId, status])
  @@index([organizationId, searchId])
  @@unique([organizationId, siren])
}

model Call {
  id             String   @id @default(cuid())
  organizationId String
  prospectId     String
  userId         String?
  day            String
  issue          String
  resume         String   @default("")
  interet        String   @default("")
  objections     Json?
  next           String   @default("")
  durationMs     Int      @default(0)
  transcript     String   @default("")
  // Identifiant de l'appel chez l'opérateur de téléphonie (appel reçu par webhook).
  externalId     String?
  recordingUrl   String   @default("")
  createdAt      DateTime @default(now())
  prospect       Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([prospectId])
}

// Consommation de l'IA par entreprise : sert au super admin et, plus tard, aux limites par formule.
model AiUsage {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  feature        String
  model          String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

// Registre des crédits : le solde est la somme des mouvements. Portefeuille d'un revendeur si resellerId est renseigné
// (organizationId indique alors le client qui a consommé), sinon celui de l'entreprise.
model CreditEntry {
  id             String   @id @default(cuid())
  organizationId String?
  resellerId     String?
  delta          Int
  // use (consommation et remboursement), essai, abonnement, recharge, manuel, expiration.
  kind           String
  label          String   @default("")
  // Facture ou paiement à l'origine du mouvement : un même paiement ne crédite jamais deux fois.
  reference      String?  @unique
  userId         String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([resellerId, createdAt])
}

model Invitation {
  id             String       @id @default(cuid())
  email          String
  role           String
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  invitedById    String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------- Messagerie (Gmail / Outlook) ----------

// Boîte mail connectée d'un utilisateur. Les jetons sont chiffrés (TOKEN_ENCRYPTION_KEY).
model MailAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  provider     String    // "google" ou "microsoft"
  email        String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Emails échangés avec un prospect : envoyés depuis l'outil ou réponses reçues.
model MailMessage {
  id             String   @id @default(cuid())
  organizationId String
  prospectId     String
  userId         String
  direction      String   // "out" ou "in"
  providerId     String
  subject        String   @default("")
  snippet        String   @default("")
  at             DateTime
  prospect       Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([organizationId, at])
  @@index([prospectId])
}

// Appels manqués et messages vocaux remontés par la téléphonie, à traiter dans le Point du jour.
model PhoneEvent {
  id             String   @id @default(cuid())
  organizationId String
  externalId     String
  kind           String   // "missed" ou "voicemail"
  number         String
  prospectId     String?
  userId         String?
  voicemailUrl   String   @default("")
  transcript     String   @default("")
  at             DateTime
  handled        Boolean  @default(false)

  @@unique([organizationId, externalId])
  @@index([organizationId, handled])
}

// Échecs de connexion récents : au-delà de 5 en 15 minutes, l'email est bloqué un moment (attaques par force brute).
model LoginAttempt {
  id    String   @id @default(cuid())
  email String
  at    DateTime @default(now())

  @@index([email, at])
}

// Lien « mot de passe oublié » : seule l'empreinte du jeton est stockée, valable 1 heure, utilisable une fois.
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}


// ---------- Revendeurs ----------

// Partenaire revendeur : utilise l'appli dans son propre espace et touche une commission sur les clients qu'il apporte.
// Rattaché à un compte utilisateur par son email.
model Reseller {
  id            String         @id @default(cuid())
  email         String         @unique
  // Code du lien d'inscription parrainé (/inscription?partenaire=CODE).
  code          String         @unique
  // Offre distributeur (src/lib/reseller-offers.ts) : A, B ou C ; facturation mensuelle ou annuelle (2 mois offerts).
  offer         String
  billing       String         @default("mensuel")
  // Options des offres A et B : marque blanche (997 €, en 1 ou 3 fois) et support prioritaire (+15 € / mois).
  upsellWhiteLabel   Boolean   @default(false)
  whiteLabelInstallments Int   @default(1)
  upsellPriority     Boolean   @default(false)
  // Offre choisie par le distributeur, en attente du paiement, puis activée.
  offerStatus   String         @default("en_attente")
  offerChosenAt DateTime?
  // Marque blanche débloquée par le fondateur, et pack de marque (nom, logo, couleurs, typographie).
  whiteLabel    Boolean        @default(false)
  brandName     String         @default("")
  brandLogo     String         @default("")
  brandColor    String         @default("")
  brandColor2   String         @default("")
  brandFont     String         @default("")
  active        Boolean        @default(true)
  companyName   String         @default("")
  siret         String         @default("")
  address       String         @default("")
  managerName   String         @default("")
  managerEmail  String         @default("")
  managerPhone  String         @default("")
  // IBAN chiffré (AES-256-GCM) ; seuls les 4 derniers caractères restent lisibles.
  ibanEnc       String         @default("")
  ibanLast4     String         @default("")
  bic           String         @default("")
  createdAt     DateTime       @default(now())
  organizations Organization[]
  tickets       SupportTicket[]
  features      FeatureRequest[]
}

// Demande de support d'un distributeur : priorité et délai selon son offre.
model SupportTicket {
  id         String   @id @default(cuid())
  resellerId String
  subject    String
  body       String
  priority   String   @default("standard")
  status     String   @default("ouvert")
  answer     String   @default("")
  dueAt      DateTime
  createdAt  DateTime @default(now())
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
}

// Demande de fonctionnalité (offre C, une par trimestre) : réponse sous 10 jours ouvrés.
model FeatureRequest {
  id         String   @id @default(cuid())
  resellerId String
  title      String
  body       String
  status     String   @default("reçue")
  answer     String   @default("")
  dueAt      DateTime
  createdAt  DateTime @default(now())
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@index([resellerId, createdAt])
}

// Communication du fondateur à tous les revendeurs, affichée dans leur Espace affilié.
model ResellerMessage {
  id        String   @id @default(cuid())
  subject   String
  body      String
  emailed   Int      @default(0)
  createdAt DateTime @default(now())
}

// Vidéos du centre d'aide affilié (liens YouTube) : demo, vente ou onboarding.
model ResellerVideo {
  id        String   @id @default(cuid())
  category  String
  title     String
  url       String
  createdAt DateTime @default(now())
}

// Liste d'opposition : emails qui ont demandé à ne plus être contactés par cette entreprise.
model OptOut {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
}
