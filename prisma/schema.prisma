// Modèle de données du socle : comptes, entreprises clientes, rôles, invitations.
// En local : SQLite. En production : PostgreSQL (Supabase), en changeant `provider` et DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  // Accès à l'ensemble des comptes clients. Toujours vrai pour le fondateur (SUPER_ADMIN_EMAILS),
  // qui est le seul à pouvoir l'accorder ou le retirer aux autres.
  isSuperAdmin Boolean      @default(false)
  // Signature des emails, remplace {signature} dans les séquences.
  signature    String       @default("")
  // Guide d'adoption (infobulles) activé, réglé dans le Centre d'aide.
  guideOn      Boolean      @default(true)
  // Dernier jour (AAAA-MM-JJ) où le point du jour a été affiché.
  briefingDay  String?
  createdAt    DateTime     @default(now())
  lastLoginAt  DateTime?
  memberships  Membership[]
  sessions     Session[]
  prospects    Prospect[]
  mailAccount  MailAccount?
}

// Une entreprise cliente : ses données sont isolées de celles des autres.
model Organization {
  id          String       @id @default(cuid())
  name        String
  // Offre choisie (identifiant de src/lib/plans.ts) ; « essai » tant qu'aucun abonnement n'est souscrit.
  plan        String       @default("essai")
  // Fin de l'essai gratuit, fixée à l'inscription.
  trialEndsAt DateTime?
  // Abonnement Stripe, tenu à jour par le webhook.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  // Téléphonie connectée (aircall, ringover, generique) et jeton secret de son webhook.
  phoneProvider        String?
  phoneWebhookToken    String?   @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  invitations Invitation[]
  searches    Search[]
  templates   SequenceTemplate[]
  prospects   Prospect[]
}

// Rôle d'un utilisateur dans une entreprise : ADMIN ou MEMBER (commercial).
model Membership {
  id             String       @id @default(cuid())
  role           String
  createdAt      DateTime     @default(now())
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// Seule l'empreinte du jeton est stockée : une fuite de la base ne permet pas d'ouvrir une session.
model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  organizationId String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Cockpit ----------
// Les dates de suivi (premier contact, relances, rappels) sont des jours « AAAA-MM-JJ » au fuseau de l'entreprise.

// Une recherche = une bibliothèque de prospects, ses critères et sa séquence.
model Search {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  geo            String            @default("")
  secteur        String            @default("")
  ca             String            @default("")
  salaries       String            @default("")
  motifs         String            @default("")
  activite       String            @default("")
  prix           String            @default("")
  diff           String            @default("")
  fonctions      String            @default("")
  volume         String            @default("")
  ton            String            @default("")
  notes          String            @default("")
  templateId     String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       SequenceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  prospects      Prospect[]

  @@index([organizationId])
}

// Modèle de séquence : emails (J0 + 5 relances) et LinkedIn en parallèle.
model SequenceTemplate {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  delays         Json         // 5 délais de relance, en jours après l'email J0
  steps          Json         // textes par étape (email, relance1Objet, linkedinInvitation…)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  searches       Search[]

  @@index([organizationId])
}

model Prospect {
  id             String       @id @default(cuid())
  organizationId String
  searchId       String?
  ownerId        String?
  company        String
  sector         String       @default("")
  city           String       @default("")
  size           String       @default("")
  contactName    String       @default("")
  contactRole    String       @default("")
  phone          String       @default("")
  email          String       @default("")
  emailVerified  Boolean      @default(false)
  linkedin       String       @default("")
  website        String       @default("")
  clientele      String       @default("")
  standing       String       @default("")
  offreExistante String       @default("")
  actualite      String       @default("")
  qualification  String       @default("")
  canal          String       @default("")
  problematiques String       @default("")
  signals        String       @default("")
  angle          String       @default("")
  notes          String       @default("")
  priority       String       @default("B")
  status         String       @default("À contacter")
  relances       Int          @default(0)
  firstContact   String?
  lastContact    String?
  nextFollowUp   String?
  callBack       String?
  lastCallAt     String?
  qualif         Json?
  sequence       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  search         Search?      @relation(fields: [searchId], references: [id], onDelete: SetNull)
  owner          User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  calls          Call[]
  // Fil Gmail de la séquence et Message-ID du dernier email envoyé : les relances répondent dans le même fil.
  mailThreadId   String?
  mailMessageId  String?
  mails          MailMessage[]

  @@index([organizationId, status])
  @@index([organizationId, searchId])
}

model Call {
  id             String   @id @default(cuid())
  organizationId String
  prospectId     String
  userId         String?
  day            String
  issue          String
  resume         String   @default("")
  interet        String   @default("")
  objections     Json?
  next           String   @default("")
  durationMs     Int      @default(0)
  transcript     String   @default("")
  // Identifiant de l'appel chez l'opérateur de téléphonie (appel reçu par webhook).
  externalId     String?
  recordingUrl   String   @default("")
  createdAt      DateTime @default(now())
  prospect       Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([prospectId])
}

// Consommation de l'IA par entreprise : sert au super admin et, plus tard, aux limites par formule.
model AiUsage {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  feature        String
  model          String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model Invitation {
  id             String       @id @default(cuid())
  email          String
  role           String
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  invitedById    String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------- Messagerie (Gmail / Outlook) ----------

// Boîte mail connectée d'un utilisateur. Les jetons sont chiffrés (TOKEN_ENCRYPTION_KEY).
model MailAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  provider     String    // "google" ou "microsoft"
  email        String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Emails échangés avec un prospect : envoyés depuis l'outil ou réponses reçues.
model MailMessage {
  id             String   @id @default(cuid())
  organizationId String
  prospectId     String
  userId         String
  direction      String   // "out" ou "in"
  providerId     String
  subject        String   @default("")
  snippet        String   @default("")
  at             DateTime
  prospect       Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([organizationId, at])
  @@index([prospectId])
}

// Appels manqués et messages vocaux remontés par la téléphonie, à traiter dans le Point du jour.
model PhoneEvent {
  id             String   @id @default(cuid())
  organizationId String
  externalId     String
  kind           String   // "missed" ou "voicemail"
  number         String
  prospectId     String?
  userId         String?
  voicemailUrl   String   @default("")
  transcript     String   @default("")
  at             DateTime
  handled        Boolean  @default(false)

  @@unique([organizationId, externalId])
  @@index([organizationId, handled])
}
